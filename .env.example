# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service_role key. Server-side only; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Console → APIs & Services → YouTube Data API v3 → Credentials
# Optional: without it, videos still save (via oEmbed) but without duration/views/dates,
# and playlist import is disabled.
YOUTUBE_API_KEY=

# Passcode everyone types to enter. Leave empty to make the site fully open.
APP_PASSCODE=
# Any long random string; used to sign the login cookie.
SESSION_SECRET=
